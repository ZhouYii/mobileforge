{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestDef",
  "description": "Quest definition for the MobileForge quest system",
  "type": "object",
  "required": ["id", "name", "category", "objectives"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique quest identifier"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "category": {
      "type": "string",
      "enum": ["daily", "weekly", "achievement", "story"],
      "description": "Quest category"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_name", "target_count"],
        "properties": {
          "event_name": {
            "type": "string",
            "description": "EventBus event name that triggers progress"
          },
          "target_count": {
            "type": "integer",
            "minimum": 1,
            "description": "How many times the event must fire"
          },
          "filter": {
            "type": "object",
            "description": "Payload key-value pairs that must match for progress",
            "additionalProperties": true
          }
        }
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "currency": { "type": "string" },
          "count": { "type": "integer" },
          "item_id": { "type": "string" }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Quest IDs that must be claimed before this quest can activate"
    },
    "repeatable": {
      "type": "boolean",
      "default": false
    }
  }
}
