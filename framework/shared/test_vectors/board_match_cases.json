{
    "description": "Match detection test cases for 5×6 board",
    "config": {"rows": 5, "cols": 6, "min_match": 3},
    "cases": [
        {
            "name": "horizontal_3_match",
            "description": "Three water gems in a row",
            "board": [
                1, 1, 1, 2, 3, 4,
                2, 3, 4, 5, 6, 1,
                3, 4, 5, 6, 1, 2,
                4, 5, 6, 1, 2, 3,
                5, 6, 1, 2, 3, 4
            ],
            "expected_matches": [
                {"element": 1, "positions": [0, 1, 2], "gem_count": 3}
            ]
        },
        {
            "name": "vertical_3_match",
            "description": "Three fire gems in a column",
            "board": [
                2, 3, 4, 5, 6, 1,
                2, 1, 3, 4, 5, 6,
                2, 4, 5, 6, 1, 3,
                3, 5, 6, 1, 2, 4,
                4, 6, 1, 2, 3, 5
            ],
            "expected_matches": [
                {"element": 2, "positions": [0, 6, 12], "gem_count": 3}
            ]
        },
        {
            "name": "horizontal_5_match",
            "description": "Five grass gems in a row",
            "board": [
                3, 3, 3, 3, 3, 1,
                1, 2, 4, 5, 6, 2,
                2, 4, 5, 6, 1, 3,
                4, 5, 6, 1, 2, 4,
                5, 6, 1, 2, 3, 5
            ],
            "expected_matches": [
                {"element": 3, "positions": [0, 1, 2, 3, 4], "gem_count": 5}
            ]
        },
        {
            "name": "l_shape_merge",
            "description": "L-shaped match should merge into one match (horizontal + vertical same element sharing a corner)",
            "board": [
                1, 1, 1, 2, 3, 4,
                3, 4, 1, 5, 6, 2,
                2, 5, 1, 6, 4, 3,
                4, 6, 3, 2, 5, 1,
                5, 2, 4, 3, 6, 2
            ],
            "expected_matches": [
                {"element": 1, "positions": [0, 1, 2, 8, 14], "gem_count": 5}
            ]
        },
        {
            "name": "t_shape_merge",
            "description": "T-shaped match merges horizontal + vertical through middle",
            "board": [
                3, 4, 2, 5, 6, 1,
                2, 2, 2, 2, 2, 3,
                4, 5, 2, 6, 1, 4,
                5, 6, 2, 1, 3, 5,
                6, 1, 3, 4, 5, 6
            ],
            "expected_matches": [
                {"element": 2, "positions": [6, 7, 8, 9, 10, 14, 20], "gem_count": 7}
            ]
        },
        {
            "name": "no_match",
            "description": "Board with no matches",
            "board": [
                1, 2, 3, 4, 5, 6,
                2, 3, 4, 5, 6, 1,
                3, 4, 5, 6, 1, 2,
                4, 5, 6, 1, 2, 3,
                5, 6, 1, 2, 3, 4
            ],
            "expected_matches": []
        },
        {
            "name": "multiple_independent_matches",
            "description": "Two separate matches on the same board",
            "board": [
                1, 1, 1, 3, 3, 3,
                2, 4, 5, 6, 4, 2,
                3, 5, 6, 4, 5, 1,
                4, 6, 4, 5, 6, 2,
                5, 4, 5, 6, 4, 3
            ],
            "expected_matches": [
                {"element": 1, "positions": [0, 1, 2], "gem_count": 3},
                {"element": 3, "positions": [3, 4, 5], "gem_count": 3}
            ]
        },
        {
            "name": "cross_shape",
            "description": "Cross/plus shape match",
            "board": [
                3, 4, 5, 6, 1, 2,
                4, 5, 2, 6, 1, 3,
                2, 2, 2, 2, 2, 4,
                5, 6, 2, 1, 3, 5,
                6, 1, 2, 4, 5, 6
            ],
            "expected_matches": [
                {"element": 2, "positions": [8, 12, 13, 14, 15, 16, 20, 26], "gem_count": 8}
            ]
        }
    ]
}
